diff --git a/crates/core/nomos-core/src/assessment.rs b/crates/core/nomos-core/src/assessment.rs
--- a/crates/core/nomos-core/src/assessment.rs
+++ b/crates/core/nomos-core/src/assessment.rs
@@ -353,8 +353,18 @@ pub fn assess(condition: &Condition, obs
     }
     match (seen, evidence, least_failure) {
         (false, _, _) => Assessment::Indeterminate(Reason::NoObservation),
